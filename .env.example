NODE_ENV=development
PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Superuser connection (postgres) - for bootstrap and migrations
# Format: postgres://username:password@host:port/database
DATABASE_URL_SUPER=postgres://postgres:SA61397618*@localhost:5432/postgres

# Application role - after bootstrap, the app connects as platform_app
# This is set AFTER running db:setup
DATABASE_URL_APP=postgres://platform_app:CHANGE_ME@localhost:5432/platform_forge_dev

# Fallback for scripts that use DATABASE_URL
DATABASE_URL=postgres://postgres:SA61397618*@localhost:5432/platform_forge_dev

# Individual PostgreSQL variables (used by some scripts)
PGHOST=localhost
PGPORT=5432
PGDATABASE=platform_forge_dev
PGSUPERUSER=postgres
PGSUPERPASSWORD=SA61397618*

# App role passwords (set during db:setup)
# IMPORTANT: Change these in production!
PLATFORM_APP_PASSWORD=CHANGE_ME
PLATFORM_WORKER_PASSWORD=CHANGE_ME
PLATFORM_MIGRATION_PASSWORD=CHANGE_ME

# ============================================
# APPLICATION CONFIGURATION
# ============================================

REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# JWT Keys (generate real keys for production!)
JWT_PRIVATE_KEY="dev-jwt-private-key-replace-in-production"
JWT_PUBLIC_KEY="dev-jwt-public-key-replace-in-production"

# Argon2id password hashing (production values are much higher)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

EMAIL_FROM=noreply@example.com
